# Local development starts the product API on port 3001 when this is empty.
# For deployment, set this to the public API origin before building the frontend.
VITE_API_BASE_URL=""

# Local product-service settings. Keep passwords and signing secrets server-only.
API_PORT=3001
API_PUBLIC_URL="http://localhost:3001"
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PRODUCT_DATA_DIR=".data/monve"
ADMIN_PASSWORD=""
ADMIN_EMAIL=""
SESSION_SECRET=""

# Optional separate events service URL; the local product API provides /api/events.
VITE_API_EVENTS_URL=""

# VITE_ values are public. Never prefix server passwords or signing keys with VITE_.
